# Copy this file to .env only when you want to change a default. With no .env
# at all, the lab talks to the local Ollama server. .env is git-ignored.

# Where the OpenAI-format API is served.
#   Local Ollama (default):  http://localhost:11434/v1
#   OpenRouter:              https://openrouter.ai/api/v1
LAB_BASE_URL=http://localhost:11434/v1

# The target model: the assistant under attack.
#   Ollama (default):        llama3.1:8b-8k   (llama3.1:8b with an 8,192-token context;
#                            build it once with: ollama create llama3.1:8b-8k -f models/llama3.1-8b-8k.Modelfile)
#   OpenRouter free models:  google/gemma-4-26b-a4b-it:free, qwen/qwen3.8-27b:free  (seen 2026-09-24)
LAB_MODEL=llama3.1:8b-8k

# OpenRouter only. Create it at openrouter.ai > Keys. Ollama ignores it.
# Free tier: 20 requests/min and 50 requests/day per account.
OPENROUTER_API_KEY=

# OpenRouter only: pin one backend provider so every run uses the same weights. Empty = any.
LAB_PROVIDER=

# Seconds between calls. Empty = 3.0 for ":free" models (the 20/min cap), 0 otherwise.
LAB_MIN_INTERVAL=

# Sampling seed sent with every call, for repeatable answers.
LAB_SEED=0
